# Copy to .env and replace every value before starting the stack:
#
#   cp .env.example .env
#   printf 'GPUOPS_AGENT_TOKEN=%s\n' "$(openssl rand -hex 32)" >> .env
#
# .env is git-ignored. Never commit real secrets.

# --- PostgreSQL ---
POSTGRES_IMAGE=postgres:18.1
POSTGRES_DB=gpuops
POSTGRES_USER=gpuops
# Required. Generate with: openssl rand -hex 24
POSTGRES_PASSWORD=
# Host port for direct psql access. Set to 127.0.0.1:5432 to avoid exposing it.
POSTGRES_PUBLISH=127.0.0.1:5432

# --- Controller ---
# Host port that serves the Web UI and API.
CONTROLLER_PUBLISH=8080
# Three DIFFERENT random values. Generate each with: openssl rand -hex 32
GPUOPS_AGENT_TOKEN=
GPUOPS_ADMIN_TOKEN=
GPUOPS_AUTH_SECRET=
# Set to true once the controller sits behind HTTPS.
GPUOPS_COOKIE_SECURE=false
# Record usage without deducting points. Recommended for the first run.
GPUOPS_DRY_RUN=true
